modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_anthropic_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "rustc"]

[userenv]

[userenv.shared]
ADMIN_EMAIL = "admin@wms.com"
MANAGER_EMAIL = "manager@wms.com"
OPERATOR_EMAIL = "operator@wms.com"
CORS_ORIGINS = "*"
BACKEND_PORT = "8000"
REACT_APP_BACKEND_URL = ""
ADMIN2_EMAIL = "bhagyesh@excellenceconsultant.in"
ADMIN2_NAME = "Admin"
ADMIN2_ROLE = "admin"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "start.sh"]
